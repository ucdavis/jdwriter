  "tidy": [
    {
      "why": "CRLF becomes LF",
      "input": "a\r\nb\r\nc",
      "output": "a\nb\nc"
    },
    {
      "why": "bare CR becomes LF",
      "input": "a\rb",
      "output": "a\nb"
    },
    {
      "why": "trailing spaces before a newline are dropped",
      "input": "a   \nb\t\nc",
      "output": "a\nb\nc"
    },
    {
      "why": "three or more newlines collapse to exactly two",
      "input": "a\n\n\n\n\nb",
      "output": "a\n\nb"
    },
    {
      "why": "two newlines are preserved (paragraph break)",
      "input": "a\n\nb",
      "output": "a\n\nb"
    },
    {
      "why": "single newline is preserved (line break)",
      "input": "a\nb",
      "output": "a\nb"
    },
    {
      "why": "leading and trailing whitespace is trimmed",
      "input": "\n\n  a\n\n  ",
      "output": "a"
    },
    {
      "why": "interior indentation is NOT stripped",
      "input": "a\n    indented\nb",
      "output": "a\n    indented\nb"
    },
    {
      "why": "empty string stays empty",
      "input": "",
      "output": ""
    },
    {
      "why": "whitespace-only becomes empty",
      "input": "  \n\n\t  ",
      "output": ""
    },
    {
      "why": "mixed CRLF and blank runs",
      "input": "a\r\n\r\n\r\n\r\nb   \r\nc",
      "output": "a\n\nb\nc"
    },
    {
      "why": "non-breaking space is left alone (not whitespace to the regex)",
      "input": "a \nb",
      "output": "a \nb"
    }
  ]
