@model string
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in | JDWriter</title>
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/favicon-32.png")" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Url.Content("~/apple-touch-icon.png")" />
    <style>
        /* The app's own face (Gunrock's Proxima Nova, from the UC Davis CDN), so sign-in matches. */
        @@font-face { font-family: "Proxima Nova"; font-weight: 400; src: url("https://ucdcdn.blob.core.windows.net/public/media/fonts/proximanova/proximanova-regular.woff2") format("woff2"); }
        @@font-face { font-family: "Proxima Nova"; font-weight: 700; src: url("https://ucdcdn.blob.core.windows.net/public/media/fonts/proximanova/proximanova-bold.woff2") format("woff2"); }
        body { margin: 0; background: #f2f5f8; color: #172b40; font-family: "Proxima Nova", system-ui, sans-serif; font-size: 16px; }
        main { max-width: 560px; margin: 10vh auto; padding: 32px; background: white; border-top: 6px solid #ffbf00; border-radius: 8px; }
        h1 { color: #022851; }
        p { line-height: 1.6; }
        button { display: block; width: 100%; padding: 16px; margin-top: 16px; text-align: left; border: 1px solid #022851; border-radius: 6px; background: #022851; color: white; font: inherit; cursor: pointer; }
        button:hover { background: #13396b; }
        button:focus-visible, a:focus-visible { outline: 3px solid #13639e; outline-offset: 3px; }
        button span { display: block; margin-top: 6px; font-size: 14px; }
        a { color: #00588a; }
        .brand { display: block; width: 72px; height: 72px; border-radius: 12px; margin-bottom: 12px; }
    </style>
</head>
<body>
<main>
    <img class="brand" src="@Url.Content("~/icon-192.png")" alt="" />
    <p>JDWriter · Development</p>
    <h1>Sign in to JDWriter</h1>
    @if (ViewData["EntraConfigured"] is true)
    {
        <form action="@Url.Content("~/login/ucdavis")" method="get">
            <input type="hidden" name="returnUrl" value="@Model" />
            <button type="submit"><strong>Sign in to UC Davis</strong></button>
        </form>
    }
    <p>Or use a fictional account for local development.</p>
    <form action="@Url.Content("~/login/local")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@Model" />
        <button name="persona" value="sample" type="submit">
            <strong>Sign in as Sample User</strong>
            <span>sample@example.test · Author and Admin</span>
        </button>
        <button name="persona" value="basic" type="submit">
            <strong>Sign in as Basic User</strong>
            <span>basic@example.test · Author</span>
        </button>
    </form>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>Signed in as <strong>@User.Identity.Name</strong>. <a href="@Model">Continue to the app</a></p>
        <form action="@Url.Content("~/logout/local")" method="post">
            @Html.AntiForgeryToken()
            <button type="submit">Sign out</button>
        </form>
    }
    <p><a href="@Url.Content("~/about")">Visit the public about page</a></p>
</main>
</body>
</html>
